  "query": "\n            SELECT \n                id as \"id?\",\n                workout_id,\n                exercise_type,\n                start_time as \"start_time: DateTime<Utc>\",\n                end_time as \"end_time: DateTime<Utc>\",\n                notes,\n                per_side_weight as \"per_side_weight: bool\",\n                split_weight as \"split_weight: bool\"\n            FROM exercises\n            WHERE LOWER(exercise_type) = LOWER(?)\n            ORDER BY start_time DESC\n            LIMIT 1\n            ",
