# SwoleMate backend configuration (example)
# Copy to `server.env` and adjust as needed.

# ---- Core server ----

# Server port (default: 2469)
SERVER_PORT=2469

# SQLite database (default: sqlite:database/swolemate.db)
DATABASE_URL=sqlite:database/swolemate.db

# Used for CORS if CORS_ALLOWED_ORIGINS is not set (default: http://localhost:2470)
FRONTEND_URL=http://localhost:2470

# Comma-separated allowed origins for CORS (overrides FRONTEND_URL)
# Example: https://swolemate.example.com,https://www.swolemate.example.com
# Notes:
# - With cookie sessions, the browser must send credentials, so origins must be explicit (no "*").
# - Origins must match exactly (scheme + host + port), e.g. http://192.168.31.233:2470
# CORS_ALLOWED_ORIGINS=

# Environment (default: development)
APP_ENV=development

# ---- Auth (username/password + cookie sessions) ----
#
# On first start (or when migrating an old DB), the server ensures at least one admin user exists.
# In production, you MUST set BOOTSTRAP_ADMIN_PASSWORD.
#
# Username for the initial admin user (default: admin)
# BOOTSTRAP_ADMIN_USERNAME=admin
#
# Password for the initial admin user (required in production)
# BOOTSTRAP_ADMIN_PASSWORD=change-me
#
# Notes:
# - The session cookie is HttpOnly and SameSite=Lax.
# - In production (APP_ENV=production) the cookie is Secure, so you must serve via HTTPS (typically behind a reverse proxy).
# - Backups + admin user management are admin-only.
# - Client logs are optionally POSTed to /api/logs and re-emitted to server stdout (Docker logs); requires authentication (any user).

# ---- HTTP hardening ----

# Enable HSTS header (ONLY if you always serve via HTTPS; typically behind a reverse proxy)
# ENABLE_HSTS=1
# HSTS_MAX_AGE=31536000

# Max JSON request body size in bytes (default: 524288)
# JSON_BODY_LIMIT_BYTES=524288

# Trust the reverse proxy's client-IP header (X-Real-IP) for per-IP rate limiting.
# Enable ONLY when the server is reachable exclusively through a proxy that sets
# this header (the bundled docker-compose does). If the server is directly
# reachable, leave this off — otherwise a client can forge X-Real-IP to evade
# rate limits. Default: false.
# TRUST_PROXY_HEADERS=true

# ---- Concurrency / overload protection ----
# NOTE: limits are per Actix worker process.
# API_MAX_INFLIGHT=64
# API_MAX_INFLIGHT_LOGS=8
# API_MAX_INFLIGHT_BACKUPS=2
# API_MAX_INFLIGHT_BACKUP_RESTORE=1
# API_CONCURRENCY_TIMEOUT_MS=1500

# ---- Session auto-close ----
# Auto-close an "active" session after N minutes of inactivity (default: 30).
# Set to 0 to disable.
# AUTO_CLOSE_INACTIVITY_MINUTES=30
#
# How often the server checks for stale sessions (default: 60 seconds).
# AUTO_CLOSE_POLL_SECONDS=60

# ---- Logging / debugging ----

# Rust logging (examples)
# RUST_LOG=info
# RUST_LOG=swolemate_server=info,actix_web=info

# Expose internal error details in HTTP responses (dangerous on public internet)
# EXPOSE_INTERNAL_ERRORS=1

# ---- MCP / OAuth foundation ----

# Public base URL used for remote MCP and OAuth discovery.
# Example: https://swolemate.example.com
# MCP_PUBLIC_BASE_URL=

# MCP transport toggles and policy.
# MCP_ENABLE_SSE=true
# MCP_REQUIRE_OAUTH=true
# MCP_RATE_LIMIT_PER_MINUTE=60

# OAuth token TTLs in seconds.
# OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Default scopes granted to new MCP clients unless explicitly overridden.
# OAUTH_DEFAULT_SCOPES=workouts.read,progress.read

# Dynamic client registration should stay disabled until client compatibility requires it.
# OAUTH_ALLOW_DYNAMIC_CLIENT_REGISTRATION=false
